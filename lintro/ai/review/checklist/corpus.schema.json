{
  "$defs": {
    "checklistRow": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": 1
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "properties": {
              "domains": {
                "maxItems": 0
              },
              "id": {
                "maximum": 15,
                "minimum": 1
              },
              "languages": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": 2
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "minimum": 100
              }
            }
          }
        }
      ],
      "description": "One built-in checklist item, parsed into a ChecklistItem by lintro.ai.review.checklist.loader.",
      "properties": {
        "category": {
          "$ref": "#/$defs/reviewCategory",
          "description": "Review finding category for this item."
        },
        "domains": {
          "description": "File domains that trigger this item; empty for Tier 1 (always-included) items.",
          "items": {
            "$ref": "#/$defs/fileDomain"
          },
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "description": "Unique item id. Tier 1 uses 1-15; Tier 2 uses >= 100.",
          "minimum": 1,
          "type": "integer"
        },
        "languages": {
          "description": "identify language tags that trigger this item; empty for Tier 1 (always-included) items.",
          "items": {
            "$ref": "#/$defs/languageTag"
          },
          "type": "array",
          "uniqueItems": true
        },
        "question": {
          "description": "Reviewer-facing question text.",
          "minLength": 1,
          "type": "string"
        },
        "tier": {
          "description": "1 for always-included items, 2 for domain/language-triggered items.",
          "enum": [
            1,
            2
          ],
          "type": "integer"
        }
      },
      "required": [
        "category",
        "domains",
        "id",
        "languages",
        "question",
        "tier"
      ],
      "title": "Checklist row",
      "type": "object"
    },
    "fileDomain": {
      "description": "Values of lintro.enums.file_domain.FileDomain.",
