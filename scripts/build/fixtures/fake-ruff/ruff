#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Fake ``ruff`` CLI: two canned F401 findings for the interactive-review gate.

Release runners install none of the wrapped external tools (see
``scripts/ci/smoke-test-binary.py``), so the built binary has nothing to
report issues for and the AI fix path would never be reached. This fixture
supplies the two findings the fake provider then offers fixes for, which keeps
the gate independent of the runner image and of the real ruff's output drift.
"""

import json
import os
import sys

args = sys.argv[1:]
if "--version" in args:
    print("ruff 0.15.9")
    sys.exit(0)

TARGET = next(
    (arg for arg in args if arg.endswith(".py") and os.path.exists(arg)),
    "bad.py",
)
print(
    json.dumps(
        [
            {
                "code": "F401",
                "message": f"`{module}` imported but unused",
                "filename": os.path.abspath(TARGET),
                "location": {"row": row, "column": 1},
                "end_location": {"row": row, "column": 10},
                "fix": None,
                "url": "https://docs.astral.sh/ruff/rules/unused-import",
            }
            for row, module in ((1, "os"), (2, "sys"))
        ],
    ),
)
sys.exit(1)
