---
import BaseLayout from '../layouts/BaseLayout.astro';
import Comparison from '../components/home/Comparison.astro';
---

<BaseLayout
  title="Compare code quality workflows"
  description="An honest overview of where Lintro fits alongside Trunk, MegaLinter, pre-commit and Qlty."
>
  <div class="container synthesis-page">
    <header class="page-intro" data-reveal>
      <a href={import.meta.env.BASE_URL}>← Back to Lintro</a>
      <h1>Pick on the merits.</h1>
      <p class="lede">
        Start with your project’s needs: tools, configuration, local workflow and reporting.
      </p>
    </header>
    <section data-reveal>
      <Comparison showHeader={false} showHealthNote={false} />
    </section>
  </div>
</BaseLayout>
