---
import { TOOL_COUNT } from '../data/tools-catalog';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Workbench from '../components/home/Workbench.astro';
import InstallPicker from '../components/home/InstallPicker.astro';
import HealthScore from '../components/home/HealthScore.astro';
import ToolCatalog from '../components/home/ToolCatalog.astro';
import AiFeatures from '../components/home/AiFeatures.astro';
import ConfigBuilder from '../components/home/ConfigBuilder.astro';
import McpConsole from '../components/home/McpConsole.astro';
import WatchAndCi from '../components/home/WatchAndCi.astro';
import Comparison from '../components/home/Comparison.astro';
---

<BaseLayout
  title="Lintro"
  description={`One CLI that runs ${TOOL_COUNT} linters, formatters, type checkers and security scanners behind a single command, normalizes their output, and adds optional bring-your-own-key AI code review.`}
>
  <section class="home-hero" id="workbench-section">
    <div class="container">
      <Hero />
      <Workbench />
      <InstallPicker />
    </div>
  </section>

  <section class="home-block">
    <div class="container">
      <HealthScore />
    </div>
  </section>

  <section class="home-block" id="tools">
    <div class="container">
      <ToolCatalog />
    </div>
  </section>

  <section class="home-block" id="ai">
    <div class="container">
      <AiFeatures />
    </div>
  </section>

  <section class="home-block" id="config">
    <div class="container">
      <ConfigBuilder />
    </div>
  </section>

  <section class="home-block" id="mcp">
    <div class="container">
      <McpConsole />
    </div>
  </section>

  <section class="home-block" id="ci">
    <div class="container">
      <WatchAndCi />
    </div>
  </section>

  <section class="home-block" id="compare">
    <div class="container">
      <Comparison />
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding: 64px 0 48px;
    scroll-margin-top: var(--header-height);
  }

  .home-block {
    padding: 72px 0;
    border-top: 1px solid var(--wb-hair);
    scroll-margin-top: var(--header-height);
  }

  @media (max-width: 700px) {
    .home-hero {
      padding: 40px 0 32px;
    }

    .home-block {
      padding: 48px 0;
    }
  }
</style>
