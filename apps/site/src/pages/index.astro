---
import BaseLayout from '../layouts/BaseLayout.astro';
import Workbench from '../components/home/Workbench.astro';
import InstallPicker from '../components/home/InstallPicker.astro';
import ToolCatalog from '../components/home/ToolCatalog.astro';
import HealthScore from '../components/home/HealthScore.astro';
import AiFeatures from '../components/home/AiFeatures.astro';
import Comparison from '../components/home/Comparison.astro';
import ShowcasePreferences from '../components/ShowcasePreferences.astro';
import ToolStrip from '../components/home/ToolStrip.astro';
import { TOOL_COUNT, FIXER_COUNT } from '../data/tools-catalog';
import { MCP_TOOLS } from '../data/home-content';
import { LINTRO_VERSION } from '../data/lintro-version';
---

<BaseLayout
  title="Lintro · explore the CLI"
  description="Try interactive examples of Lintro checks, formatting, watch mode and AI review. Browse the tools and build your configuration."
>
  <div class="synthesis-home container">
    <header class="compact-intro" data-reveal>
      <div class="compact-intro-main">
        <h1>Try it out.</h1>
        <p class="compact-lede">
          One CLI for {TOOL_COUNT} linters, formatters, type checkers and security scanners — using
          your native tool configs.
        </p>
      </div>
      <p class="release-meta">
        <span>v{LINTRO_VERSION}</span>
        <span>MIT licensed</span>
        <span>Python 3.11+</span>
      </p>
    </header>
    <ShowcasePreferences />
    <section aria-label="Explore Lintro" class="synthesis-surface" id="demo" data-reveal>
      <Workbench />
      <InstallPicker />
    </section>
    <ToolStrip />
    <section class="instrument-facts" aria-label="Lintro capabilities" data-reveal>
      {[
        { value: TOOL_COUNT, label: 'built-in integrations' },
        { value: FIXER_COUNT, label: 'declare fix support' },
        { value: MCP_TOOLS.length, label: 'MCP tools over stdio' },
      ].map(({ value, label }) => (
        <p>
          <strong data-count={value} aria-hidden="true">
            {value}
          </strong>
          <span class="sr-only">{value}</span>
          <span>{label}</span>
        </p>
      ))}
    </section>
    <div class="synthesis-section" data-reveal>
      <HealthScore />
    </div>
    <section class="synthesis-section" id="tools" aria-label="Tool catalog">
      <ToolCatalog />
    </section>
    <section class="synthesis-section" id="ai" aria-label="AI features" data-reveal>
      <AiFeatures />
    </section>
    <section class="synthesis-section" id="comparison" aria-label="Honest comparison" data-reveal>
      <Comparison />
    </section>
  </div>
</BaseLayout>
