---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CommandReference from '../../../../components/docs/CommandReference.astro';
import snapshot from '../../../../generated/product-snapshot.json';
export function getStaticPaths() {
  return snapshot.commands.filter(command => command.name).map(command => ({params:{command:command.name.replaceAll(' ', '-')},props:{command}}));
}
const { command } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`lintro ${command.name} — CLI reference`} description={`Public help, parameters, declared defaults and choices for lintro ${command.name}, version ${snapshot.version}.`}>
  <article class="reference-shell" data-pagefind-body>
    <a class="text-link" href={`${base}docs/reference/cli/`}>← All commands</a>
    <p class="eyebrow">Public command · v{snapshot.version}</p>
    <h1><code>lintro {command.name}</code></h1>
    <p class="doc-notice">Declared Click defaults are shown before invocation. Runtime logic, environment and configuration can supply effective values. An unset value stays explicitly unresolved here.</p>
    <CommandReference command={command} />
    <p><a href={`${base}docs/reference/cli/`}>Back to all commands →</a></p>
  </article>
</BaseLayout>
