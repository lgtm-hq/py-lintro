---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommandReference from '../../../components/docs/CommandReference.astro';
import snapshot from '../../../generated/product-snapshot.json';
const commands = snapshot.commands.filter(command => command.name);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="CLI reference" description={`Lintro ${snapshot.version} public command tree: nested commands, aliases, options, defaults and choices from frozen Click help.`}>
  <article class="reference-shell" data-pagefind-body>
    <a class="text-link" href={`${base}docs/`}>← Documentation</a>
    <p class="eyebrow">Command reference · v{snapshot.version}</p>
    <h1>From task to command.</h1>
    <p class="lede">Choose a command for its complete public help, arguments, options and subcommands.</p>
    <p class="doc-notice">Generated from the release’s actual Click command tree. Defaults below are declared Click values before invocation. Configuration, environment and command logic can supply effective values; “not set” is not a resolved product default.</p>
    <nav class="command-directory" aria-label="Commands">{commands.map(command => <a id={command.name.replaceAll(' ', '-')} href={`${base}docs/reference/cli/${command.name.replaceAll(' ', '-')}/`}><code>lintro {command.name}</code><span>{command.summary.split('\n')[0]}</span><span aria-hidden="true">↗</span></a>)}</nav>
    <h2>Root command</h2>
    {snapshot.commands[0] && <CommandReference command={snapshot.commands[0]} />}
  </article>
</BaseLayout>
<script>
  const fragment = location.hash.slice(1);
  const link = fragment ? document.getElementById(fragment) : null;
  if (link instanceof HTMLAnchorElement) location.replace(link.href);
</script>
