---
import { joinBase } from '../data/landing';
import { hasUriScheme } from '../lib/url-utils';
interface Props { name: string; href: string; external?: boolean; showArrow?: boolean; showIcon?: boolean; class?: string }
const { name, href, external: externalProp, showArrow = false, showIcon = true, class: className } = Astro.props;
const base = import.meta.env.BASE_URL;
const isAbsolute = hasUriScheme(href) || href.startsWith('//');
const opensInNewTab = /^https?:\/\//i.test(href) || href.startsWith('//');
const external = externalProp ?? opensInNewTab;
const url = !isAbsolute && !href.startsWith('#') && (external || !href.startsWith(base)) ? joinBase(base, href) : href;
---
<a class:list={['smart-link', className]} href={url} target={external && opensInNewTab ? '_blank' : undefined} rel={external && opensInNewTab ? 'noopener noreferrer' : undefined}>
  {showIcon && <img class="smart-link-icon" src={joinBase(base, 'assets/smart-link-fallback.svg')} alt="" width="16" height="16" loading="lazy" decoding="async" />}
  <span class="smart-link-label">{name}</span>{showArrow && <span class="smart-link-arrow" aria-hidden="true">↗</span>}
</a>
