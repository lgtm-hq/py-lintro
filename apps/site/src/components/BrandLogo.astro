---
interface Props {
  class?: string;
  as?: 'span' | 'strong';
}

const { class: className, as: Element = 'span' }: Props = Astro.props;
---

<Element class:list={['brand-logo', className]}>
  <span class="brand-logo-mark" aria-hidden="true"></span>
  <span class="brand-logo-name">lintro</span>
</Element>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--wb-navy);
  }

  .brand-logo-mark {
    position: relative;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: var(--wb-navy);
    flex-shrink: 0;
  }

  .brand-logo-mark::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--wb-accent);
  }
</style>
