---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<button
  type="button"
  id="search-open"
  class="search-trigger js-only"
  aria-label="Search ⌘ K"
  aria-description="Search documentation"
  aria-haspopup="dialog"
  aria-expanded="false"
  aria-controls="site-search"
>
  <span aria-hidden="true">⌕</span>
  <span class="search-word">Search</span>
  <kbd id="search-shortcut">⌘ K</kbd>
</button>
<dialog id="site-search" class="search-dialog" aria-label="Find your next step" data-base={base}>
  <div class="search-heading">
    <h2 id="search-heading">Find your next step</h2>
    <button type="button" id="search-close" aria-keyshortcuts="Escape">
      Close <kbd>esc</kbd>
    </button>
  </div>
  <form id="search-form" role="search">
    <fieldset id="search-fields" disabled>
      <label for="search-query">Search</label>
      <input
        type="text"
        id="search-query"
        placeholder="Search documentation..."
        autocomplete="off"
        spellcheck="false"
        aria-describedby="search-status"
      />
      <label class="search-matching">
        <input type="checkbox" id="search-partial" /> Include partial word matches
      </label>
    </fieldset>
  </form>
  <p id="search-status" role="status" aria-live="polite">
    Loading the search index…
  </p>
  <div id="search-error" hidden>
    <p role="alert">Search could not load. You can retry or browse the documentation.</p>
    <button type="button" id="search-retry">
      Retry search
    </button>
    <a href={`${base}/docs/`}>Browse all sections</a>
  </div>
  <ul id="search-results" class="search-results" aria-label="Search results"></ul>
  <button type="button" id="search-more" hidden>
    Show more results
  </button>
  <p class="search-help">Whole words by default. Try “baseline”, “ruff” or “MCP”.</p>
</dialog>
<script>
  import {
    findResults,
    prioritizeTitles,
    type SearchIndex,
    type SearchHit,
  } from '../lib/search-results';
  /** Render excerpts using text and mark elements; all other markup stays inert. */
  function excerptText(excerpt: string): DocumentFragment {
    const source = document.createElement('template');
    source.innerHTML = excerpt;
    const output = document.createDocumentFragment();
    for (const node of source.content.childNodes) {
      if (node instanceof Element && node.tagName === 'MARK') {
        const mark = document.createElement('mark');
        mark.textContent = node.textContent;
        output.append(mark);
      } else {
        output.append(document.createTextNode(node.textContent ?? ''));
      }
    }
    return output;
  }

  /** Bind the native search dialog to the local Pagefind API, with retry and race protection. */
  function initSiteSearch(): void {
    const dialog = document.querySelector<HTMLDialogElement>('#site-search');
    const trigger = document.querySelector<HTMLButtonElement>('#search-open');
    const input = document.querySelector<HTMLInputElement>('#search-query');
    const partial = document.querySelector<HTMLInputElement>('#search-partial');
    const form = document.querySelector<HTMLFormElement>('#search-form');
    const fields = document.querySelector<HTMLFieldSetElement>('#search-fields');
    const status = document.querySelector<HTMLElement>('#search-status');
    const list = document.querySelector<HTMLUListElement>('#search-results');
    const error = document.querySelector<HTMLElement>('#search-error');
    const retry = document.querySelector<HTMLButtonElement>('#search-retry');
    const more = document.querySelector<HTMLButtonElement>('#search-more');
    if (
      !dialog ||
      !trigger ||
      !input ||
      !partial ||
      !form ||
      !fields ||
      !status ||
      !list ||
      !error ||
      !retry ||
      !more
    )
      return;
    const base = dialog.dataset.base ?? '';
    const shortcut = document.querySelector('#search-shortcut');
    if (shortcut)
      shortcut.textContent = /Mac|iPhone|iPad/.test(navigator.platform) ? '⌘ K' : 'Ctrl K';
    let index: SearchIndex | undefined;
    let loading: Promise<void> | undefined;
    let attempts = 0;
    let revision = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let matches: SearchHit[] = [];
    let shown = 0;

    const appendResults = async (hits: SearchHit[], request: number): Promise<void> => {
      const data = await Promise.all(hits.map((hit) => hit.data()));
      if (request !== revision) return;
      for (const item of prioritizeTitles(data, input.value)) {
        const url = new URL(item.url, location.origin);
        if (url.origin !== location.origin) continue;
        const row = document.createElement('li');
        row.className = 'search-result';
        const heading = document.createElement('h3');
        const link = document.createElement('a');
        link.href = url.href;
        link.textContent = item.meta.title ?? item.url;
        heading.append(link);
        const excerpt = document.createElement('p');
        excerpt.append(excerptText(item.excerpt));
        row.append(heading, excerpt);
        list.append(row);
      }
    };

    const search = async (): Promise<void> => {
      if (!index) return;
      const request = ++revision;
      const term = input.value.trim();
      list.replaceChildren();
      more.hidden = true;
      error.hidden = true;
      if (!term) {
        status.textContent = 'Enter a word or phrase to search the documentation.';
        return;
      }
      status.textContent = 'Searching…';
      try {
        const hits = await findResults(index, term, partial.checked);
        if (request !== revision) return;
        matches = hits;
        shown = Math.min(8, matches.length);
        await appendResults(matches.slice(0, shown), request);
        if (request !== revision) return;
        status.textContent = hits.length
          ? `${hits.length} results for ${term}`
          : `No results for ${term}. Try fewer words or include partial word matches.`;
        more.hidden = shown >= matches.length;
      } catch {
        if (request !== revision) return;
        status.textContent = 'Search could not load. Check your connection and try again.';
        error.hidden = false;
      }
    };

    const load = async (): Promise<void> => {
      if (index) return;
      if (loading) return loading;
      fields.disabled = true;
      status.textContent = 'Loading the search index…';
      error.hidden = true;
      loading = (async () => {
        try {
          const suffix = attempts++ ? `?retry=${attempts}` : '';
          const module = (await import(
            /* @vite-ignore */ `${base}/pagefind/pagefind.js${suffix}`
          )) as SearchIndex;
          if (typeof module.search !== 'function') throw new Error('Search API unavailable');
          index = module;
          fields.disabled = false;
          await search();
        } catch {
          status.textContent = 'Search could not load. Check your connection and try again.';
          error.hidden = false;
          if (dialog.open) retry.focus();
        } finally {
          loading = undefined;
        }
      })();
      return loading;
    };

    const open = async (): Promise<void> => {
      if (!dialog.open) dialog.showModal();
      trigger.setAttribute('aria-expanded', 'true');
      await load();
      if (dialog.open && index) input.focus();
    };
    trigger.addEventListener('click', () => void open());
    retry.addEventListener('click', async () => {
      revision++;
      if (timer) clearTimeout(timer);
      retry.disabled = true;
      const failedIndex = index;
      index = undefined;
      try {
        // Pagefind caches initialization promises, including rejected resource loads.
        // Dispose that state before importing a fresh API for an explicit retry.
        await failedIndex?.destroy?.();
        await load();
        if (index && dialog.open) input.focus();
      } catch {
        status.textContent = 'Search could not load. Check your connection and try again.';
        error.hidden = false;
      } finally {
        retry.disabled = false;
      }
    });
    input.addEventListener('input', () => {
      revision++;
      if (timer) clearTimeout(timer);
      timer = setTimeout(() => void search(), 200);
    });
    partial.addEventListener('change', () => void search());
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (timer) clearTimeout(timer);
      void search();
    });
    more.addEventListener('click', async () => {
      more.disabled = true;
      const request = revision;
      try {
        const next = Math.min(shown + 8, matches.length);
        await appendResults(matches.slice(shown, next), request);
        if (request !== revision) return;
        shown = next;
        more.hidden = shown >= matches.length;
      } catch {
        status.textContent = 'More results could not load. Try searching again.';
        error.hidden = false;
      } finally {
        more.disabled = false;
      }
    });
    document.querySelector('#search-close')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      trigger.setAttribute('aria-expanded', 'false');
      trigger.focus();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close();
    });
    document.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        void open();
      }
    });
  }

  initSiteSearch();
</script>
<style>
  .search-matching {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font-size: 0.8rem;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  #search-fields > label:first-child {
    display: block;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }
  #search-query {
    width: 100%;
    min-height: 44px;
    padding: 0.75rem;
    font: inherit;
    background: var(--wb-surface);
    color: var(--wb-ink);
    border: 1px solid var(--wb-hair);
    border-radius: 8px;
  }
  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  :global(.search-result) {
    padding-block: 1rem;
    border-bottom: 1px solid var(--wb-hair);
    /* A long title or path must wrap inside the dialog at narrow widths and large text. */
    overflow-wrap: anywhere;
  }
  :global(.search-result h3) {
    font-size: 1rem;
    margin: 0 0 0.5rem;
  }
  :global(.search-result p) {
    font-size: 0.85rem;
    line-height: 1.6;
    margin: 0;
  }
  :global(.search-result mark) {
    background: var(--wb-surface-2);
    color: var(--wb-ink);
    font-weight: 600;
  }
  #search-retry,
  #search-more {
    min-height: 44px;
    padding: 0.6rem 1rem;
    font: inherit;
    color: var(--wb-ink);
    background: var(--wb-surface-2);
    border: 1px solid var(--wb-hair);
    border-radius: 8px;
    margin-block: 0.5rem;
  }
  .search-open {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 40px;
    background: var(--wb-surface);
    color: var(--wb-muted);
    border: 1px solid var(--wb-hair);
    border-radius: 8px;
    padding: 7px 11px;
    font-size: 0.78rem;
  }
  .search-open kbd {
    font-size: 0.75rem;
    border: 1px solid var(--wb-hair);
    border-radius: 4px;
    padding: 2px 4px;
  }
  dialog {
    position: fixed;
    inset: 0;
    margin: 80px auto auto;
    width: min(680px, calc(100% - 24px));
    max-height: calc(100dvh - 100px);
    overflow: auto;
    background: var(--wb-surface);
    color: var(--wb-ink);
    border: 1px solid var(--wb-hair);
    border-radius: 18px;
    padding: 24px;
    box-shadow: var(--wb-shadow);
  }
  dialog::backdrop {
    background: color-mix(in srgb, var(--turbo-text-primary) 65%, transparent);
  }
  .search-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }
  .search-heading h2 {
    font-size: 1.2rem;
  }
  .search-heading button {
    padding: 8px;
    border: 1px solid var(--wb-hair);
    border-radius: 6px;
    background: var(--wb-surface-2);
    color: var(--wb-ink);
    min-height: 40px;
    font-size: 0.75rem;
  }
  .search-heading kbd {
    margin-left: 6px;
    font-size: 0.75rem;
  }
  .search-help {
    font-size: 0.75rem;
    color: var(--wb-muted);
    padding-top: 18px;
  }
  @media (max-width: 600px) {
    .search-open span,
    .search-open kbd {
      display: none;
    }
    .search-open {
      width: 40px;
      padding: 0;
    }
    .search-heading h2 {
      font-size: 1rem;
    }
    dialog {
      padding: 18px;
      margin-top: 20px;
      max-height: calc(100dvh - 40px);
    }
  }
</style>
