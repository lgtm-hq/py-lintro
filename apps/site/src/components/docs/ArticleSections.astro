---
import { articleSections } from '../../lib/article-sections';
import ArticleSectionLinks from './ArticleSectionLinks.astro';
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
const sections = articleSections(headings);
---

{headings.length >= 3 && (
  <details class="article-sections" data-pagefind-ignore>
    <summary>On this page · {headings.length} sections</summary>
    <nav aria-label="Article sections">
      <ArticleSectionLinks sections={sections} />
    </nav>
  </details>
)}
<style>
  .article-sections {
    display: none;
    margin-block: 1.5rem;
    border-block: 1px solid var(--wb-hair);
  }
  :global(html:not(.js)) .article-sections {
    display: block;
  }
  summary {
    padding-block: 0.9rem;
    cursor: pointer;
    font-weight: 600;
  }
  nav > :global(ul) {
    max-height: 24rem;
    overflow-y: auto;
    padding: 0 1rem 1rem;
    list-style: none;
    margin: 0;
  }
  nav :global(li) {
    margin-block: 0.3rem;
  }
  nav :global(ul ul) {
    padding-inline-start: 1.25rem;
    list-style: none;
  }
  nav :global(a) {
    display: block;
    color: var(--wb-ink);
    padding-block: 0.35rem;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }
  @media (max-width: 1180px) {
    .article-sections {
      display: block;
    }
  }
</style>
