---
import { getCollection } from 'astro:content';
import {
  CATEGORY_LABELS,
  docRoute,
  findSectionOverviewDoc,
  type DocCategory,
} from '../../data/docs-nav';
import { groupSectionDocs, sidebarLabel } from '../../data/sidebar-nav';

interface Props {
  currentSlug: string;
  currentCategory: DocCategory;
}

const { currentSlug, currentCategory } = Astro.props;
const base = import.meta.env.BASE_URL;

const allDocs = await getCollection('docs', ({ data }) => !data.draft);
const overview = findSectionOverviewDoc(allDocs, currentCategory);
const sectionDocs = allDocs
  .filter((d) => d.data.category === currentCategory && d.data.sidebar !== false)
  .sort((a, b) => a.data.order - b.data.order);
const sectionLabel = CATEGORY_LABELS[currentCategory];
const { groups } = groupSectionDocs(currentCategory, sectionDocs);
const overviewHref = overview ? docRoute(base, overview.id) : undefined;
const overviewActive = overview?.id === currentSlug;
---

<aside class="docs-sidebar" aria-label={`${sectionLabel} pages`} data-pagefind-ignore>
  <p class="docs-sidebar-section">
    {sectionLabel}
    <span>{sectionDocs.length}</span>
  </p>

  {
    overviewHref && (
      <a
        href={overviewHref}
        class:list={['docs-sidebar-link', 'docs-sidebar-overview', { active: overviewActive }]}
        aria-current={overviewActive ? 'page' : undefined}
      >
        Overview
      </a>
    )
  }

  {
    groups.map((group) => {
      const isActiveGroup = group.docs.some((doc) => doc.id === currentSlug);
      return (
        <details class="docs-sidebar-group" open={isActiveGroup}>
          <summary>
            <span>{group.label}</span>
            <span class="docs-sidebar-group-meta">
              {group.docs.length}
              <svg class="docs-sidebar-group-chevron" viewBox="0 0 12 12" aria-hidden="true">
                <path
                  d="M2.5 4.5 6 8l3.5-3.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                />
              </svg>
            </span>
          </summary>
          {group.docs.map((doc) => (
            <a
              href={docRoute(base, doc.id)}
              class:list={['docs-sidebar-link', { active: doc.id === currentSlug }]}
              aria-current={doc.id === currentSlug ? 'page' : undefined}
            >
              {sidebarLabel(doc)}
            </a>
          ))}
        </details>
      );
    })
  }
</aside>

<div class="docs-mobile-nav" data-pagefind-ignore>
  <label class="docs-mobile-nav-label" for="docs-page-jump">{sectionLabel}</label>
  <select id="docs-page-jump" class="docs-mobile-nav-select">
    {
      overviewHref && (
        <option value={overviewHref} selected={overviewActive}>
          Overview
        </option>
      )
    }
    {
      groups.map((group) => (
        <optgroup label={group.label}>
          {group.docs.map((doc) => (
            <option value={docRoute(base, doc.id)} selected={doc.id === currentSlug}>
              {sidebarLabel(doc)}
            </option>
          ))}
        </optgroup>
      ))
    }
  </select>
</div>

<script>
  function initDocsPageJump(): void {
    const select = document.getElementById('docs-page-jump');
    if (!(select instanceof HTMLSelectElement) || select.dataset.bound === 'true') {
      return;
    }
    select.dataset.bound = 'true';
    select.addEventListener('change', () => {
      if (select.value) {
        window.location.href = select.value;
      }
    });
  }

  initDocsPageJump();
  document.addEventListener('astro:page-load', initDocsPageJump);
</script>
