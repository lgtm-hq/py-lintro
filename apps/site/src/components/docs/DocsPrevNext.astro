---
import { getCollection } from 'astro:content';
import { docRoute, type DocCategory } from '../../data/docs-nav';
import { prevNextDocs, sidebarLabel } from '../../data/sidebar-nav';

interface Props {
  category: DocCategory;
  slug: string;
}

const { category, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const sectionDocs = await getCollection(
  'docs',
  ({ data }) => !data.draft && data.category === category && data.sidebar !== false
);
const { prev, next } = prevNextDocs(category, sectionDocs, slug);
---

{
  (prev || next) && (
    <nav class="docs-prevnext" aria-label="Previous and next pages" data-pagefind-ignore>
      {prev && (
        <a href={docRoute(base, prev.id)} class="docs-prevnext-card prev" rel="prev">
          <small>Previous</small>
          <strong>{sidebarLabel(prev)}</strong>
        </a>
      )}
      {next && (
        <a href={docRoute(base, next.id)} class="docs-prevnext-card next" rel="next">
          <small>Next</small>
          <strong>{sidebarLabel(next)}</strong>
        </a>
      )}
    </nav>
  )
}
