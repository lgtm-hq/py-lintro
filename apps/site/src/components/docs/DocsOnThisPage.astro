---
interface Props {
  enabled?: boolean;
}
const { enabled = true } = Astro.props;
---

{enabled && (
  <aside class="docs-toc js-only" data-pagefind-ignore aria-label="On this page">
    <p class="docs-toc-title">On this page</p>
    <nav class="docs-toc-nav">
      <ul class="docs-toc-list" id="docs-toc-list"></ul>
    </nav>
  </aside>
)}
<script>
  const list = document.getElementById('docs-toc-list');
  const headings = [
    ...document.querySelectorAll<HTMLHeadingElement>(
      '.docs-content .prose h2[id], .docs-content .prose h3[id], .docs-content .prose h4[id]'
    ),
  ].filter((heading) => !heading.closest('[data-pagefind-ignore]'));
  if (headings.length === 0) list?.closest('aside')?.remove();
  const links = new Map<string, HTMLAnchorElement>();
  headings.forEach((heading) => {
    if (!list) return;
    const li = document.createElement('li');
    li.className =
      heading.tagName !== 'H2' ? 'docs-toc-item docs-toc-item--nested' : 'docs-toc-item';
    const link = document.createElement('a');
    link.href = `#${heading.id}`;
    link.textContent = heading.textContent;
    link.className = 'docs-toc-link';
    li.append(link);
    list.append(li);
    links.set(heading.id, link);
  });
  function landingOffset(heading: HTMLElement): number {
    const padding =
      Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    const margin = Number.parseFloat(getComputedStyle(heading).scrollMarginTop) || 0;
    return padding + margin;
  }
  function syncActiveSection(): void {
    let active = headings[0]?.id;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= landingOffset(heading) + 2) active = heading.id;
      else break;
    }
    links.forEach((link, id) => {
      const isActive = id === active;
      link.classList.toggle('is-active', isActive);
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }
  let observer: IntersectionObserver;
  function observeSections(): void {
    observer?.disconnect();
    const offset = headings[0] ? landingOffset(headings[0]) : 0;
    observer = new IntersectionObserver(syncActiveSection, {
      rootMargin: `-${offset + 1}px 0px 0px 0px`,
      threshold: [0, 1],
    });
    headings.forEach((heading) => observer.observe(heading));
    requestAnimationFrame(syncActiveSection);
  }
  observeSections();
  window.addEventListener('hashchange', () => requestAnimationFrame(syncActiveSection));
  window.addEventListener('scrollend', syncActiveSection);
  window.addEventListener('resize', observeSections);
  window.addEventListener('pageshow', () => requestAnimationFrame(syncActiveSection));
</script>
