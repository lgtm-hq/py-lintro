---
import BrandLogo from './BrandLogo.astro';
import ThemeDropdown from './ThemeDropdown.astro';
import SearchDropdown from './SearchDropdown.astro';
import NavDropdown from './NavDropdown.astro';
import { getCollection } from 'astro:content';
import { buildMainNav } from '../data/docs-nav';
import { docs, docHref, external } from '../data/site-links';

const base = import.meta.env.BASE_URL;
const docsCollection = await getCollection('docs', ({ data }) => !data.draft);
const nav = buildMainNav(base, docsCollection);
const installHref = docHref(base, docs.gettingStarted);
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a href={base} class="logo-link" aria-label="Lintro home">
      <BrandLogo />
    </a>

    <nav class="header-nav" aria-label="Main">
      {
        nav.map((item) =>
          item.groups.length > 0 ? (
            <NavDropdown label={item.label} href={item.href} groups={item.groups} />
          ) : (
            <a href={item.href} class="nav-link">
              {item.label}
            </a>
          )
        )
      }
      <a
        href={external.github.href}
        class="nav-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </nav>

    <div class="header-controls">
      <SearchDropdown />
      <ThemeDropdown />
      <a href={installHref} class="btn btn-primary btn-sm header-install">Install</a>
      <button
        type="button"
        class="nav-toggle"
        id="nav-toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Main (mobile)" hidden>
    {
      nav.map((item) => (
        <div class="mobile-nav-section">
          <a href={item.href} class="mobile-nav-link">
            {item.label}
          </a>
          {item.groups.map((group) => (
            <div class="mobile-nav-group">
              <p class="mobile-nav-group-label">{group.label}</p>
              {group.items.map((entry) => (
                <a href={entry.href} class="mobile-nav-item">
                  {entry.label}
                </a>
              ))}
            </div>
          ))}
        </div>
      ))
    }
    <div class="mobile-nav-section">
      <a href={external.github.href} class="mobile-nav-link" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <a href={installHref} class="btn btn-primary">Install</a>
    </div>
  </nav>
</header>

<script>
  function initMobileNav(): void {
    const toggle = document.getElementById('nav-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!toggle || !panel || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';

    const setOpen = (open: boolean): void => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden === true));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  initMobileNav();
  document.addEventListener('astro:page-load', initMobileNav);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid var(--wb-hair);
    background: color-mix(in srgb, var(--wb-ground) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
    height: var(--header-height);
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .logo-link:hover {
    text-decoration: none;
  }

  .header-nav {
    display: flex;
    gap: 0.15rem;
    flex: 1;
    align-items: center;
  }

  .header-nav :global(.nav-link) {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    font-size: 0.925rem;
    font-weight: 500;
    color: var(--wb-muted);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background var(--transition-fast);
  }

  .header-nav :global(.nav-link:hover),
  .header-nav :global(.nav-dropdown.is-open .nav-link) {
    background: var(--wb-surface-2);
    color: var(--wb-ink);
    text-decoration: none;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .nav-toggle {
    display: none;
    width: 36px;
    height: 36px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wb-hair);
    border-radius: var(--radius-md);
    background: var(--wb-surface);
    color: var(--wb-ink);
  }

  .mobile-nav {
    display: grid;
    gap: 1.25rem;
    padding: 1rem 24px 1.5rem;
    border-top: 1px solid var(--wb-hair);
    background: var(--wb-surface);
    max-height: calc(100dvh - var(--header-height));
    overflow-y: auto;
  }

  .mobile-nav[hidden] {
    display: none;
  }

  .mobile-nav-section {
    display: grid;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--wb-navy);
    text-decoration: none;
  }

  .mobile-nav-group {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--wb-hair);
  }

  .mobile-nav-group-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wb-muted);
    margin: 0.35rem 0 0.1rem;
  }

  .mobile-nav-item {
    color: var(--wb-ink);
    font-size: 0.925rem;
    text-decoration: none;
    padding: 0.2rem 0;
  }

  @media (max-width: 900px) {
    .header-nav,
    .header-install {
      display: none;
    }

    .nav-toggle {
      display: inline-flex;
    }
  }
</style>
