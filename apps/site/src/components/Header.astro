---
import BrandLogo from './BrandLogo.astro';
import ThemeDropdown from './ThemeDropdown.astro';
import SearchDropdown from './SearchDropdown.astro';
const base = import.meta.env.BASE_URL;
const links = [
  ['Docs', 'docs/'],
  ['Demo', '#demo'],
  ['Tools', '#tools'],
  ['AI', 'ai/'],
  ['Config Builder', 'config-builder/'],
  ['MCP', 'mcp/'],
  ['Plugins', 'docs/contribute/plugins/'],
  ['Compare', 'compare/'],
];
---

<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <a href={base} class="logo-link" aria-label="Lintro home">
      <BrandLogo />
    </a>
    <nav class="header-nav" aria-label="Main">
      {links.map(([label, path]) => (
        <a class="nav-link" href={`${base}${path}`}>
          {label}
        </a>
      ))}
    </nav>
    <div class="header-controls">
      <SearchDropdown />
      <ThemeDropdown />
      <a class="btn btn-primary header-install" href={`${base}docs/start/getting-started/`}>
        Start{' '}
        <span class="orb" aria-hidden="true">
          ↗
        </span>
      </a>
      <details class="mobile-menu">
        <summary aria-label="Navigation menu">
          <span class="menu-lines" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
          <span class="sr-only">Menu</span>
        </summary>
        <nav aria-label="Mobile navigation">
          {links.map(([label, path]) => (
            <a href={`${base}${path}`}>{label}</a>
          ))}
          <a href="https://github.com/lgtm-hq/py-lintro">Source on GitHub ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-menu').forEach((menu) => {
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
</script>
