---
import BrandLogo from './BrandLogo.astro';
import { docs, docHref, external } from '../data/site-links';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

const columns: FooterColumn[] = [
  {
    title: 'Docs',
    links: [
      { label: 'Getting started', href: docHref(base, docs.gettingStarted) },
      { label: 'Configuration', href: docHref(base, docs.configuration) },
      { label: 'AI features', href: docHref(base, docs.aiFeatures) },
      { label: 'Tool catalog', href: docHref(base, docs.toolsIndex) },
      { label: 'All documentation', href: docHref(base, docs.hub) },
    ],
  },
  {
    title: 'Install',
    links: [
      { label: 'PyPI', href: external.pypi.href, external: true },
      { label: 'npm', href: external.npm.href, external: true },
      { label: 'Docker image', href: external.docker.href, external: true },
      { label: external.homebrew.label, href: external.homebrew.href, external: true },
    ],
  },
  {
    title: 'Project',
    links: [
      { label: 'GitHub', href: external.github.href, external: true },
      { label: 'Issues', href: `${external.github.href}/issues`, external: true },
      { label: 'Releases', href: `${external.github.href}/releases`, external: true },
      { label: 'Coverage report', href: docHref(base, docs.coverage) },
      { label: 'Security', href: docHref(base, docs.security) },
    ],
  },
];

const trust: FooterLink[] = [
  external.scorecard,
  external.bestPractices,
  external.codeql,
  external.sbom,
  external.codecov,
];
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="footer-inner">
    <div class="footer-grid">
      <div class="footer-brand">
        <BrandLogo as="strong" />
        <p class="footer-tagline">
          One CLI for every linter, formatter, type checker and security scanner in your stack.
        </p>
        <ul class="footer-trust" aria-label="Trust and supply-chain signals">
          {
            trust.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        columns.map((column) => (
          <div class="footer-col">
            <h2>{column.title}</h2>
            {column.links.map((link) => (
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener noreferrer' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </div>
    <p class="footer-bottom">
      <span>MIT License © {year} lgtm-hq</span>
      <span>Lintro lints, formats and reviews its own repository on every pull request.</span>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--wb-hair);
    background: var(--wb-surface);
    padding: 48px 0 32px;
    margin-top: 72px;
    color: var(--wb-muted);
    font-size: 0.875rem;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 24px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 2rem;
  }

  .footer-brand {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .footer-tagline {
    max-width: 34ch;
    line-height: 1.5;
  }

  .footer-trust {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 0.25rem;
  }

  .footer-trust a {
    display: inline-block;
    padding: 2px 9px;
    border: 1px solid var(--wb-hair);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    color: var(--wb-muted);
    text-decoration: none;
  }

  .footer-trust a:hover {
    border-color: var(--wb-accent);
    color: var(--wb-ink);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .footer-col h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wb-muted);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    color: var(--wb-ink);
    text-decoration: none;
  }

  .footer-col a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--wb-hair);
    font-size: 0.8rem;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
