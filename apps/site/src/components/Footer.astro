---
import { LINTRO_VERSION } from '../data/lintro-version';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer" data-pagefind-ignore>
  <div class="container footer-grid">
    <div><a class="footer-brand" href={base}>lintro<span aria-hidden="true">.</span></a><p>Bring your tools.<br />Find your signal.</p><small>v{LINTRO_VERSION} · Open source · MIT</small></div>
    <nav aria-label="Explore"><span class="eyebrow">Explore</span><a href={`${base}docs/`}>Documentation</a><a href={`${base}docs/reference/cli/`}>CLI reference</a><a href={`${base}docs/guides/configuration/`}>Configuration</a><a href={`${base}docs/project/roadmap/`}>Roadmap</a></nav>
    <nav aria-label="Project"><span class="eyebrow">Project</span><a href="https://github.com/lgtm-hq/py-lintro">GitHub ↗</a><a href={`${base}docs/contribute/`}>Contribute</a><a href={`${base}docs/project/security/`}>Security</a><a href="https://pypi.org/project/lintro/">PyPI ↗</a></nav>
  </div>
</footer>
