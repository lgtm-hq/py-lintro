<script>
  function initAiTabs(): void {
    const root = document.getElementById('ai-features');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.ai-tab'));
    const select = (tab: HTMLButtonElement): void => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        const next = tabs[(i + delta + tabs.length) % tabs.length];
        if (!next) return;
        e.preventDefault();
        select(next);
        next.focus();
      });
    });
  }

  initAiTabs();
  document.addEventListener('astro:page-load', initAiTabs);
</script>
