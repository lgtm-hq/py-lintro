---
import { docHref, docs } from '../../data/site-links';

const base = import.meta.env.BASE_URL;
const SCORE = 91;
const CIRCUMFERENCE = 2 * Math.PI * 74;
const offset = (CIRCUMFERENCE * (1 - SCORE / 100)).toFixed(2);
---

<div class="health" id="health">
  <svg class="dial" viewBox="0 0 180 180" role="img" aria-label={`Example health score ${SCORE} of 100`}>
    <circle class="track" cx="90" cy="90" r="74" fill="none" stroke-width="12"></circle>
    <circle
      class="arc"
      id="dial-arc"
      cx="90"
      cy="90"
      r="74"
      fill="none"
      stroke-width="12"
      stroke-dasharray={CIRCUMFERENCE.toFixed(2)}
      stroke-dashoffset={offset}
      transform="rotate(-90 90 90)"></circle>
    <text x="90" y="92" text-anchor="middle" font-size="44" font-weight="700" id="dial-num">{SCORE}</text>
    <text class="sub" x="90" y="116" text-anchor="middle" font-size="12">of 100 · example</text>
  </svg>
  <div class="health-body">
    <div>
      <span class="eyebrow">Health score</span>
      <h2>One number for the whole repo, gated in CI.</h2>
    </div>
    <p class="muted">
      Every check run rolls findings into a 0–100 score with weights you control in the
      <code>score</code> section of <a href={docHref(base, docs.configuration)}>your config</a>.
      Print it, gate on it, or badge it.
    </p>
    <div class="badge-row">
      <span class="badge-preview" aria-label="Badge preview">
        <span class="l">lintro</span><span class="r" id="badge-val">{SCORE} / 100</span>
      </span>
      <code id="badge-md">![lintro](https://img.shields.io/badge/lintro-{SCORE}%2F100-4c1)</code>
    </div>
    <p class="score-note" id="score-note">
      Example score. Filter the tool catalog below and watch it move.
    </p>
    <div class="flagrow">
      <div class="flag-pill"><code>lintro check --score</code><span>Print only the number</span></div>
      <div class="flag-pill"><code>lintro check --fail-under 80</code><span>Exit 1 below the threshold</span></div>
      <div class="flag-pill"><code>lintro badge</code><span>shields.io markdown badge</span></div>
    </div>
    <div class="tiers">
      <span>Config tiers in <code>.lintro-config.yaml</code>:</span>
      <span class="pill">execution</span><span class="pill">enforce</span><span class="pill">defaults</span><span class="pill">tools</span><span class="pill">ai</span>
      <span>+ optional review · score · watch</span>
    </div>
  </div>
</div>

<style>
  .health {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 32px;
    align-items: center;
    padding: 28px 32px;
    background: var(--wb-surface);
    border: 1px solid var(--wb-hair);
    border-radius: var(--wb-radius);
  }

  .dial {
    display: block;
    width: 180px;
    height: 180px;
  }

  .dial .track {
    stroke: var(--wb-hair);
  }

  .dial .arc {
    stroke: var(--wb-accent);
    stroke-linecap: round;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .dial text {
    fill: var(--wb-navy);
    font-family: var(--wb-font-display);
  }

  .dial .sub {
    fill: var(--wb-muted);
    font-family: var(--wb-font-body);
  }

  .health-body {
    display: grid;
    gap: 16px;
  }

  .health-body h2 {
    margin-top: 6px;
  }

  .health-body a {
    color: var(--turbo-link-default, var(--wb-ink));
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--wb-muted);
  }

  .badge-row code {
    font-size: 0.78rem;
  }

  .badge-preview {
    display: inline-flex;
    overflow: hidden;
    border-radius: 4px;
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.1);
    font-family: var(--wb-font-body);
    font-size: 11px;
    line-height: 20px;
  }

  .badge-preview .l {
    padding: 0 6px;
    background: #555;
    color: #fff;
  }

  .badge-preview :global(.r) {
    padding: 0 6px;
    background: #4c1;
    color: #fff;
    font-weight: 600;
  }

  .badge-preview :global(.r.warn) {
    background: #dfb317;
  }

  .badge-preview :global(.r.bad) {
    background: #e05d44;
  }

  .score-note {
    font-size: 0.8rem;
    color: var(--wb-muted);
  }

  .flagrow {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .flag-pill {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    min-width: 150px;
    padding: 8px 12px;
    background: var(--wb-surface-2);
    border: 1px solid var(--wb-hair);
    border-radius: 8px;
  }

  .flag-pill code {
    padding: 0;
    border: 0;
    background: none;
    font-size: 0.85rem;
    color: var(--wb-ink);
  }

  .flag-pill span {
    font-size: 0.78rem;
    color: var(--wb-muted);
  }

  .tiers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: var(--wb-muted);
  }

  .tiers .pill {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--wb-accent-soft);
    font-family: var(--wb-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--wb-ink);
  }

  @media (max-width: 700px) {
    .health {
      grid-template-columns: 1fr;
      justify-items: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dial .arc {
      transition: none;
    }
  }
</style>

<script>
  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const CIRCUMFERENCE = 2 * Math.PI * 74;
  const DEFAULT_SCORE = 91;

  interface ScoreDetail {
    score: number;
    note?: string;
  }

  function initHealthScore(): void {
    const root = document.getElementById('health');
    const arc = document.getElementById('dial-arc');
    const num = document.getElementById('dial-num');
    const badgeVal = document.getElementById('badge-val');
    const badgeMd = document.getElementById('badge-md');
    const note = document.getElementById('score-note');
    if (!root || !arc || !num || !badgeVal || !badgeMd || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    let current = REDUCE ? DEFAULT_SCORE : 0;
    let raf: number | null = null;

    const paint = (v: number): void => {
      num.textContent = String(Math.round(v));
      arc.setAttribute('stroke-dashoffset', String(CIRCUMFERENCE * (1 - v / 100)));
    };

    const badge = (v: number): void => {
      const r = Math.round(v);
      const color = r >= 90 ? '4c1' : r >= 75 ? 'dfb317' : 'e05d44';
      badgeVal.textContent = `${r} / 100`;
      badgeVal.className = `r${r >= 90 ? '' : r >= 75 ? ' warn' : ' bad'}`;
      badgeMd.textContent = `![lintro](https://img.shields.io/badge/lintro-${r}%2F100-${color})`;
    };

    const to = (target: number, ms = 700): void => {
      badge(target);
      if (REDUCE) {
        current = target;
        paint(current);
        return;
      }
      if (raf !== null) cancelAnimationFrame(raf);
      const from = current;
      let start: number | null = null;
      const frame = (ts: number): void => {
        if (start === null) start = ts;
        const p = Math.min(1, (ts - start) / ms);
        const e = 1 - Math.pow(1 - p, 3);
        current = from + (target - from) * e;
        paint(current);
        raf = p < 1 ? requestAnimationFrame(frame) : null;
      };
      raf = requestAnimationFrame(frame);
    };

    arc.style.transition = 'none';
    paint(current);
    badge(DEFAULT_SCORE);
    to(DEFAULT_SCORE, 1100);

    document.addEventListener('lintro:score', (event) => {
      const detail = (event as CustomEvent<ScoreDetail>).detail;
      if (!detail) return;
      to(Math.min(100, Math.max(0, detail.score)));
      if (note && detail.note) note.textContent = detail.note;
    });
  }

  initHealthScore();
  document.addEventListener('astro:page-load', initHealthScore);
</script>
