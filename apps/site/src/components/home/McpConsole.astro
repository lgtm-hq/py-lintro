---
import { docHref, docs } from '../../data/site-links';
import {
  MCP_DEFAULT_TOOL,
  MCP_RESPONSES,
  MCP_TOOLS,
  colorJson,
  withVersion,
} from '../../data/home-content';
import { LINTRO_VERSION } from '../../data/lintro-version';

const base = import.meta.env.BASE_URL;

interface ToolRow {
  name: (typeof MCP_TOOLS)[number];
  readOnly: boolean;
  idempotent: boolean;
  returns: string;
  note?: string;
}

const rows: ToolRow[] = [
  { name: 'lintro_ping', readOnly: true, idempotent: true, returns: 'status, lintro version, workspace' },
  {
    name: 'lintro_check',
    readOnly: true,
    idempotent: true,
    returns: 'Structured findings plus a per-tool summary',
  },
  {
    name: 'lintro_format',
    readOnly: false,
    idempotent: false,
    returns: 'Unified diffs, changed files, remaining findings.',
    note: 'dry_run defaults to true: the tools really run, the tree is diffed and restored byte-identical.',
  },
  {
    name: 'lintro_review',
    readOnly: true,
    idempotent: false,
    returns: 'AI review findings plus run and budget metadata',
  },
  {
    name: 'lintro_list_tools',
    readOnly: true,
    idempotent: true,
    returns: 'Every tool with type, languages, install state',
  },
  {
    name: 'lintro_versions',
    readOnly: true,
    idempotent: true,
    returns: 'Installed versus expected tool versions',
  },
  {
    name: 'lintro_doctor',
    readOnly: true,
    idempotent: true,
    returns: 'health, checks, summary, each with a remediation',
  },
];

const initialResponse = colorJson(withVersion(MCP_RESPONSES[MCP_DEFAULT_TOOL], LINTRO_VERSION));
const clientConfig = JSON.stringify(
  { mcpServers: { lintro: { command: 'lintro', args: ['mcp'] } } },
  null,
  2
);
---

<header class="section-header">
  <span class="eyebrow">MCP server</span>
  <h2>Your coding agent gets the same seven tools, with structured results.</h2>
  <p class="lede">
    <code>lintro mcp</code> speaks MCP over stdio. Install with
    <code>uv pip install 'lintro[mcp]'</code>. Every declared path must stay inside
    <code>--workspace</code>. See the <a href={docHref(base, docs.mcp)}>MCP server guide</a>.
  </p>
</header>

<div class="split" id="mcp-console" data-version={LINTRO_VERSION}>
  <div class="scroll-x">
    <table>
      <thead><tr><th>Tool</th><th>Annotations</th><th>Returns</th></tr></thead>
      <tbody>
        {
          rows.map((t) => (
            <tr>
              <td><code>{t.name}</code></td>
              <td>
                <span class:list={['ann', t.readOnly ? 'ro' : 'dz']}>
                  {t.readOnly ? 'read-only' : 'destructive'}
                </span>
                <span class="ann">{t.idempotent ? 'idempotent' : 'not idempotent'}</span>
              </td>
              <td>
                {t.returns}
                {t.note && (
                  <>
                    {' '}
                    <b>{t.note}</b>
                  </>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="stack">
    <div class="console" aria-label="MCP request console">
      <div class="ctl">
        <select id="mcp-tool" aria-label="MCP tool">
          {
            MCP_TOOLS.map((name) => (
              <option value={name} selected={name === MCP_DEFAULT_TOOL}>
                {name}
              </option>
            ))
          }
        </select>
        <button type="button" class="btn btn-primary btn-sm" id="mcp-call">Call</button>
        <span class="status" id="mcp-status">example response · <span class="ok">ok</span></span>
      </div>
      <div class="term">
        <div class="cap" id="mcp-cap">response · {MCP_DEFAULT_TOOL}</div>
        <pre id="mcp-out" set:html={initialResponse} />
      </div>
    </div>
    <div class="codebox">
      <div class="cap">Generic MCP client config</div>
      <pre><code>{clientConfig}</code></pre>
    </div>
    <p class="muted small">
      Findings come from the same serializer that feeds JSON and SARIF, so an agent, a CI upload and
      a terminal never disagree about a finding. Advisory finders are not reachable here; they run
      under <code>lintro review</code> only.
    </p>
  </div>
</div>

<style>
  .section-header {
    display: grid;
    gap: 10px;
    max-width: 70ch;
    margin-bottom: 36px;
  }

  .section-header a {
    color: var(--turbo-link-default, var(--wb-ink));
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 28px;
    align-items: start;
  }

  .stack {
    display: grid;
    gap: 16px;
  }

  .small {
    font-size: 0.9rem;
  }

  table {
    width: 100%;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--wb-hair);
    border-collapse: collapse;
    border-radius: var(--wb-radius);
    background: var(--wb-surface);
    font-size: 0.9rem;
  }

  th,
  td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--wb-hair);
    text-align: left;
    vertical-align: top;
  }

  th {
    background: var(--wb-surface-2);
    font-family: var(--wb-font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--wb-muted);
  }

  tbody tr:last-child td {
    border-bottom: 0;
  }

  td code {
    white-space: nowrap;
  }

  .ann {
    display: inline-block;
    margin-right: 4px;
    padding: 1px 6px;
    border: 1px solid var(--wb-hair);
    border-radius: 4px;
    background: var(--wb-surface-2);
    font-size: 0.72rem;
    color: var(--wb-muted);
  }

  .ann.ro {
    border-color: transparent;
    background: var(--wb-pass-soft);
    color: var(--wb-pass);
  }

  .ann.dz {
    border-color: transparent;
    background: var(--wb-fail-soft);
    color: var(--wb-fail);
  }

  .console {
    display: grid;
    gap: 12px;
  }

  .console .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .console select {
    padding: 8px 10px;
    border: 1px solid var(--wb-hair);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-surface-2);
    font: inherit;
    font-family: var(--wb-font-mono);
    font-size: 0.9rem;
    color: var(--wb-ink);
  }

  .console :global(.btn-primary:disabled) {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    font-family: var(--wb-font-mono);
    font-size: 0.78rem;
    color: var(--wb-muted);
  }

  .status :global(.ok) {
    color: var(--wb-pass);
  }

  .term {
    padding: 18px 20px;
    background: var(--wb-terminal);
    border: 1px solid var(--wb-chrome-hair);
    border-radius: var(--wb-radius);
    color: #cfd8e6;
  }

  .term pre {
    min-height: 200px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--wb-font-mono);
    font-size: 0.8rem;
    line-height: 1.55;
    white-space: pre;
  }

  .term :global(.ok) {
    color: #5fd39a;
  }
  .term :global(.er) {
    color: #ff7b7b;
  }
  .term :global(.hi) {
    color: #ffd46a;
  }
  .term :global(.key) {
    color: #8fd3f4;
  }

  .term .cap {
    margin-bottom: 10px;
    font-family: var(--wb-font-body);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #6c7a93;
  }

  .codebox {
    padding: 16px 18px;
    background: var(--wb-surface);
    border: 1px solid var(--wb-hair);
    border-radius: var(--wb-radius);
  }

  .codebox pre {
    margin: 0;
    overflow-x: auto;
    font-family: var(--wb-font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    white-space: pre;
    color: var(--wb-ink);
  }

  .codebox .cap {
    margin-bottom: 8px;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--wb-muted);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import {
    MCP_RESPONSES,
    MCP_STATUS_NOTES,
    colorJson,
    isMcpToolName,
    withVersion,
  } from '../../data/home-content';

  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initMcpConsole(): void {
    const root = document.getElementById('mcp-console');
    const select = document.getElementById('mcp-tool') as HTMLSelectElement | null;
    const out = document.getElementById('mcp-out');
    const cap = document.getElementById('mcp-cap');
    const status = document.getElementById('mcp-status');
    const call = document.getElementById('mcp-call') as HTMLButtonElement | null;
    if (!root || !select || !out || !cap || !status || !call || root.dataset.bound === 'true') {
      return;
    }
    root.dataset.bound = 'true';
    const version = root.dataset.version ?? '';

    const show = (name: string): void => {
      cap.textContent = `response · ${name}`;
      out.innerHTML = colorJson(
        isMcpToolName(name) ? withVersion(MCP_RESPONSES[name], version) : '{}'
      );
    };

    call.addEventListener('click', () => {
      const name = select.value;
      call.disabled = true;
      status.textContent = `calling ${name} over stdio…`;
      cap.textContent = `request · ${name}`;
      const args = name === 'lintro_format' ? '{ "dry_run": true }' : '{}';
      out.innerHTML = colorJson(
        `{\n  "method": "tools/call",\n  "params": { "name": "${name}", "arguments": ${args} }\n}`
      );
      const note = (isMcpToolName(name) && MCP_STATUS_NOTES[name]) || 'idempotent';
      setTimeout(
        () => {
          show(name);
          status.innerHTML = `example response · <span class="ok">ok</span> · ${note}`;
          call.disabled = false;
        },
        REDUCE ? 0 : 550
      );
    });

    select.addEventListener('change', () => {
      show(select.value);
      status.innerHTML = 'example response · <span class="ok">ok</span>';
    });
  }

  initMcpConsole();
  document.addEventListener('astro:page-load', initMcpConsole);
</script>
