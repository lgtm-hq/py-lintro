---
const tabs = [
  { key: 'check', label: 'Check' },
  { key: 'format', label: 'Format' },
  { key: 'watch', label: 'Watch' },
  { key: 'review', label: 'Review' },
  { key: 'mcp', label: 'MCP' },
] as const;
---

<div class="bench" id="workbench" aria-label="Interactive workbench">
  <div class="bench-tabs" role="tablist" aria-label="Commands">
    {
      tabs.map((t, i) => (
        <button
          type="button"
          class="bench-tab"
          role="tab"
          id={`bt-${t.key}`}
          aria-controls={`bp-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {t.label}
        </button>
      ))
    }
  </div>

  <div class="bench-panel" role="tabpanel" id="bp-check" aria-labelledby="bt-check">
    <div class="bench-cmd">
      <pre tabindex="0" id="check-cmd"><span class="prompt">$</span> lintro check <span class="flag">--output-format grid</span></pre>
      <p class="note">
        <b>Pick files, watch only the relevant tools run.</b> Lintro maps each tool to its own file
        patterns, reads your existing <code>.prettierrc</code> and <code>pyproject.toml</code>, and
        runs the matches in parallel.
      </p>
      <div class="filetree" id="filetree" aria-label="Example files to check">
        <span class="dir">src/</span>
        <label class="on"><input type="checkbox" value="src/utils/paths.py" data-kind="py" checked /> src/utils/paths.py</label>
        <label class="on"><input type="checkbox" value="src/api/client.py" data-kind="py" checked /> src/api/client.py</label>
        <span class="dir">root</span>
        <label class="on"><input type="checkbox" value="config.yaml" data-kind="yaml" checked /> config.yaml</label>
        <label><input type="checkbox" value="Dockerfile" data-kind="docker" /> Dockerfile</label>
        <label><input type="checkbox" value="README.md" data-kind="md" /> README.md</label>
      </div>
      <div class="ctl">
        <button type="button" class="primary" id="check-run">Run check</button>
        <span class="note small">Example figures. Real timings depend on your machine.</span>
      </div>
    </div>
    <div class="bench-out">
      <div class="run-lines" id="check-lines" aria-live="polite">
        <div class="run-line done"><span>ruff</span><span class="res"><span class="wr">! 3 issues</span> <span class="dim">(0.47s)</span></span></div>
        <div class="run-line done"><span>mypy</span><span class="res"><span class="ok">✓ passed</span> <span class="dim">(1.34s)</span></span></div>
        <div class="run-line done"><span>bandit</span><span class="res"><span class="ok">✓ passed</span> <span class="dim">(0.62s)</span></span></div>
        <div class="run-line done"><span>black</span><span class="res"><span class="wr">! 1 issue</span> <span class="dim">(0.31s)</span></span></div>
        <div class="run-line done"><span>yamllint</span><span class="res"><span class="wr">! 1 issue</span> <span class="dim">(0.09s)</span></span></div>
        <div class="run-line done"><span>prettier</span><span class="res"><span class="ok">✓ passed</span> <span class="dim">(0.41s)</span></span></div>
      </div>
      <div class="findings" id="check-findings"><span class="dim">ruff         </span>src/utils/paths.py:12:8  <span class="key">F401 </span> `os` imported but unused  <span class="ok">fixable</span>
<span class="dim">ruff         </span>src/utils/paths.py:40:1  <span class="key">E302 </span> expected 2 blank lines  <span class="ok">fixable</span>
<span class="dim">ruff         </span>src/api/client.py:88:5   <span class="key">B006 </span> mutable default argument
<span class="dim">black        </span>src/api/client.py        <span class="key">     </span> would reformat  <span class="ok">fixable</span>
<span class="dim">yamllint     </span>config.yaml:3:81          <span class="key">line-length</span> line too long (94 &gt; 80)</div>
      <div class="sim-foot">
        <span id="check-summary">6 tools · 3 files · 5 issues · 1.34s wall</span>
        <span>Health score: <span class="hi" id="check-score">85 / 100</span></span>
      </div>
    </div>
  </div>

  <div class="bench-panel" role="tabpanel" id="bp-format" aria-labelledby="bt-format" hidden>
    <div class="bench-cmd">
      <pre tabindex="0"><span class="prompt">$</span> lintro format <span class="flag">--diff</span></pre>
      <p class="note">
        <b>Fix what the formatters can fix.</b> Fifteen of the forty tools write changes. Chain
        commands with a comma: <code>lintro fmt . , chk .</code>
      </p>
      <dl>
        <dt>--diff</dt><dd>Format only changed files</dd>
        <dt>--tools black,shfmt</dt><dd>Pick formatters</dd>
        <dt>ai.lint: true</dt><dd>AI suggests fixes for what remains, then summarizes</dd>
      </dl>
    </div>
    <div class="bench-out"><pre tabindex="0"><span class="dim">Formatting 6 changed files vs origin/HEAD</span>

ruff       <span class="ok">✓ fixed 2</span>   (0.66s)
black      <span class="ok">✓ fixed 1</span>   (0.31s)
prettier   <span class="ok">✓ fixed 1</span>   (0.44s)
shfmt      <span class="ok">✓ passed</span>    (0.05s)
taplo      <span class="ok">✓ passed</span>    (0.03s)

<span class="wr">1 issue could not be auto-fixed</span>
  src/api/client.py:88:5  B006  mutable default argument

<span class="dim">Run</span> lintro check --fix <span class="dim">to review an AI-generated diff for it.</span></pre></div>
  </div>

  <div class="bench-panel" role="tabpanel" id="bp-watch" aria-labelledby="bt-watch" hidden>
    <div class="bench-cmd">
      <pre tabindex="0"><span class="prompt">$</span> lintro watch src/</pre>
      <p class="note">
        <b>Instant feedback while you edit.</b> Only the tools that match the changed file run. A
        300 ms debounce folds a burst of saves into one run.
      </p>
      <dl>
        <dt>--fix</dt><dd>Format on save</dd>
        <dt>--tools ruff,mypy</dt><dd>Narrow the set</dd>
        <dt>--debounce 500</dt><dd>Wait longer for quiet</dd>
      </dl>
      <div class="ctl">
        <button type="button" class="primary" id="watch-save">Save foo.py</button>
        <button type="button" id="watch-save-ts">Save app.ts</button>
        <span class="note small">Click twice quickly: one run, not two.</span>
      </div>
      <div class="debounce" id="watch-debounce">
        <span>debounce 300 ms</span>
        <span class="bar"><i id="watch-debounce-bar"></i></span>
        <span id="watch-debounce-txt"></span>
      </div>
    </div>
    <div class="bench-out">
      <div class="watch-log" id="watch-log" tabindex="0" role="log" aria-live="polite"><span class="dim">Watching for changes in src/...</span>
<span class="dim">Press Ctrl+C to stop</span>

<span class="entry"><span class="key">[12:34:56]</span> foo.py modified
  ├─ ruff: <span class="ok">✓ passed</span> (0.12s)
  ├─ mypy: <span class="wr">! 1 issue</span> (1.34s)
  │  foo.py:42: Missing type annotation
  └─ bandit: <span class="ok">✓ passed</span> (0.40s)
</span></div>
    </div>
  </div>

  <div class="bench-panel" role="tabpanel" id="bp-review" aria-labelledby="bt-review" hidden>
    <div class="bench-cmd">
      <pre tabindex="0" id="review-cmd"><span class="prompt">$</span> lintro review <span class="flag">--pr 214 --depth 2 --strictness balanced --post</span></pre>
      <p class="note">
        <b>AI reviews the diff, not the repo.</b> Findings get P1/P2/P3 severity. The verdict is
        computed from severities in code, never asked of the model. <code>--post</code> writes a
        sticky summary plus inline comments to the PR.
      </p>
      <div class="ctl">
        <label>Depth
          <select id="review-depth" aria-label="Review depth">
            <option value="1">1 · checklist</option>
            <option value="2" selected>2 · + questions</option>
            <option value="3">3 · + adversarial</option>
          </select>
        </label>
        <label>Strictness
          <select id="review-strict" aria-label="Review strictness">
            <option value="focused">focused</option>
            <option value="balanced" selected>balanced</option>
            <option value="thorough">thorough</option>
          </select>
        </label>
      </div>
      <dl>
        <dt>--base main</dt><dd>Diff against a branch</dd>
        <dt>--uncommitted</dt><dd>Review your working tree</dd>
        <dt>--max-cost-usd 2</dt><dd>Hard cap on the api transport</dd>
      </dl>
      <p class="note small">Example figures. Findings and cost vary with the diff and the model.</p>
    </div>
    <div class="bench-out"><pre tabindex="0" id="review-out" aria-live="polite"><span class="dim">Reviewing PR #214 · 7 files · depth 2 · balanced</span>
<span class="dim">Coverage: 5/7 files carried from round 1 · 2 new · 4 provider calls</span>

<span class="er">P1</span> src/api/client.py:88  mutable default argument shared
   across calls; <span class="dim">rubric: correctness &gt; shared state</span>
<span class="wr">P2</span> src/db/orders.py:41   raw cursor.execute outside
   repository layer  <span class="dim">source: no-raw-sql</span>
<span class="wr">P2</span> src/api/client.py:112 retry loop swallows the last exception
   <span class="dim">rubric: error handling &gt; silent failure · generated question</span>
<span class="hi">P3</span> docs/usage.md:12      stale flag name --format

<span class="dim">Verdict:</span> <span class="er">Blocked</span> <span class="dim">(1 open P1)</span>
<span class="dim">Posted sticky summary + 4 inline comments</span>
<span class="dim">Cost: $0.25 · exit 1 · example figures</span></pre></div>
  </div>

  <div class="bench-panel" role="tabpanel" id="bp-mcp" aria-labelledby="bt-mcp" hidden>
    <div class="bench-cmd">
      <pre tabindex="0"><span class="prompt">$</span> lintro mcp <span class="flag">--workspace .</span></pre>
      <p class="note">
        <b>Give your coding agent the same tools.</b> Seven MCP tools over stdio, returning
        structured findings from the same serializer that feeds JSON and SARIF.
      </p>
      <dl>
        <dt>lintro_check</dt><dd>Findings + per-tool summary</dd>
        <dt>lintro_format</dt><dd>dry_run defaults to true; returns real diffs</dd>
        <dt>lintro_review</dt><dd>AI review with budget metadata</dd>
      </dl>
    </div>
    <div class="bench-out"><pre tabindex="0"><span class="dim">// lintro_check → response</span>
&#123;
  <span class="key">"findings"</span>: [&#123;
    <span class="key">"tool"</span>: <span class="hi">"ruff"</span>, <span class="key">"file"</span>: <span class="hi">"src/utils/paths.py"</span>,
    <span class="key">"line"</span>: 12, <span class="key">"column"</span>: 8, <span class="key">"rule"</span>: <span class="hi">"F401"</span>,
    <span class="key">"severity"</span>: <span class="hi">"WARNING"</span>,
    <span class="key">"message"</span>: <span class="hi">"`os` imported but unused"</span>,
    <span class="key">"fixable"</span>: <span class="ok">true</span>
  &#125;],
  <span class="key">"tools"</span>: [&#123; <span class="key">"tool"</span>: <span class="hi">"ruff"</span>, <span class="key">"status"</span>: <span class="hi">"issues"</span>,
              <span class="key">"issue_count"</span>: 1, <span class="key">"duration"</span>: 0.47 &#125;],
  <span class="key">"summary"</span>: &#123; <span class="key">"total_findings"</span>: 1, <span class="key">"success"</span>: <span class="er">false</span> &#125;
&#125;</pre></div>
  </div>
</div>

<style>
  .bench {
    overflow: hidden;
    background: var(--wb-chrome);
    color: var(--wb-chrome-ink);
    border: 1px solid var(--wb-chrome-hair);
    border-radius: 14px;
    box-shadow: var(--wb-shadow);
  }

  .bench-tabs {
    display: flex;
    gap: 2px;
    padding: 8px 12px 0;
    overflow-x: auto;
    border-bottom: 1px solid var(--wb-chrome-hair);
  }

  .bench-tab {
    margin-bottom: -1px;
    padding: 10px 16px 12px;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-family: var(--wb-font-display);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--wb-chrome-muted);
    white-space: nowrap;
  }

