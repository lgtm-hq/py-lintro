    color: var(--wb-chrome-ink);
    border-bottom-color: var(--wb-accent);
  }

  .bench-panel {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }

  .bench-panel[hidden] {
    display: none;
  }

  .bench-cmd {
    display: grid;
    align-content: start;
    gap: 18px;
    padding: 22px 24px;
    border-right: 1px solid var(--wb-chrome-hair);
  }

  .bench-cmd pre {
    margin: 0;
    overflow-x: auto;
    font-family: var(--wb-font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    white-space: pre;
    color: var(--wb-chrome-ink);
  }

  .bench-cmd :global(.prompt) {
    color: var(--wb-accent);
  }

  .bench-cmd :global(.flag) {
    color: #8fd3f4;
  }

  .note {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--wb-chrome-muted);
  }

  .note.small {
    font-size: 0.78rem;
  }

  .note b {
    font-weight: 600;
    color: var(--wb-chrome-ink);
  }

  .bench-cmd code {
    padding: 0.05em 0.35em;
    border: 1px solid var(--wb-chrome-hair);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.05);
    font-family: var(--wb-font-mono);
    font-size: 0.85em;
    color: var(--wb-chrome-ink);
  }

  .bench-cmd dl {
