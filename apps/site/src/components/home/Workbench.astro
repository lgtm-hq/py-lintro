  }

  .sim-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font-family: var(--wb-font-mono);
    font-size: 0.82rem;
    color: #7f8da6;
  }

  .debounce {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 20px;
    font-family: var(--wb-font-mono);
    font-size: 0.78rem;
    color: var(--wb-chrome-muted);
  }

  .debounce .bar {
    position: relative;
    width: 160px;
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
  }

  .debounce .bar i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--wb-accent);
    transition: width 0.3s linear;
  }

  .watch-log {
    max-height: 300px;
    overflow: auto;
    font-family: var(--wb-font-mono);
    font-size: 0.82rem;
    line-height: 1.55;
    white-space: pre;
    color: #cfd8e6;
  }

  .watch-log :global(.entry.is-new) {
    animation: bench-slidein 0.25s ease-out;
  }

  @keyframes bench-slidein {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 860px) {
    .bench-panel {
      grid-template-columns: 1fr;
    }

    .bench-cmd {
      border-right: 0;
      border-bottom: 1px solid var(--wb-chrome-hair);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .watch-log :global(.entry.is-new),
    .run-lines :global(.bar i),
    .debounce .bar i {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  import { escapeHtml as esc } from '../../data/home-content';

  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function wireTabs(root: HTMLElement): void {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.bench-tab'));
    const select = (tab: HTMLButtonElement): void => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      }
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        const delta = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!delta) return;
        const next = tabs[(i + delta + tabs.length) % tabs.length];
        if (!next) return;
        e.preventDefault();
        select(next);
        next.focus();
      });
    });
  }

  /* ---------- check simulator ---------- */
  const KIND_TOOLS: Record<string, string[]> = {
    py: ['ruff', 'mypy', 'bandit', 'black'],
    yaml: ['yamllint', 'prettier'],
    docker: ['hadolint'],
    md: ['markdownlint'],
  };

  interface ToolResult {
    t: number;
    issues: (files: string[]) => number;
  }

  const TOOL_RESULTS: Record<string, ToolResult> = {
    ruff: { t: 0.47, issues: (files) => countFindings('ruff', files) },
    mypy: { t: 1.34, issues: (files) => countFindings('mypy', files) },
    bandit: { t: 0.62, issues: (files) => countFindings('bandit', files) },
    black: { t: 0.31, issues: (files) => countFindings('black', files) },
    yamllint: { t: 0.09, issues: (files) => countFindings('yamllint', files) },
    prettier: { t: 0.41, issues: (files) => countFindings('prettier', files) },
    hadolint: { t: 0.18, issues: (files) => countFindings('hadolint', files) },
    markdownlint: { t: 0.22, issues: (files) => countFindings('markdownlint', files) },
  };

  type Finding = [tool: string, loc: string, rule: string, msg: string, fixable: boolean];

  const FINDINGS: Record<string, Finding[]> = {
    'src/utils/paths.py': [
      ['ruff', 'src/utils/paths.py:12:8 ', 'F401 ', '`os` imported but unused', true],
      ['ruff', 'src/utils/paths.py:40:1 ', 'E302 ', 'expected 2 blank lines', true],
    ],
    'src/api/client.py': [
      ['ruff', 'src/api/client.py:88:5  ', 'B006 ', 'mutable default argument', false],
      ['black', 'src/api/client.py       ', '     ', 'would reformat', true],
    ],
    'config.yaml': [
      ['yamllint', 'config.yaml:3:81         ', 'line-length', 'line too long (94 > 80)', false],
    ],
    Dockerfile: [
      ['hadolint', 'Dockerfile:1            ', 'DL3007', 'using latest is prone to errors', false],
      ['hadolint', 'Dockerfile:7            ', 'DL3008', 'pin versions in apt-get install', false],
    ],
    'README.md': [['markdownlint', 'README.md:14          ', 'MD013', 'line length', false]],
  };

  /** Issue count for one tool over the selected paths, so totals match the findings pane. */
  function countFindings(tool: string, files: string[]): number {
    return files.flatMap((p) => FINDINGS[p] ?? []).filter((f) => f[0] === tool).length;
  }

  function initCheck(): void {
    const tree = document.getElementById('filetree');
    const cmd = document.getElementById('check-cmd');
    const lines = document.getElementById('check-lines');
    const findings = document.getElementById('check-findings');
    const summary = document.getElementById('check-summary');
    const score = document.getElementById('check-score');
    const run = document.getElementById('check-run');
    if (!tree || !cmd || !lines || !findings || !summary || !score || !run) return;

    let runToken = 0;

    const selected = (): { path: string; kind: string }[] =>
      Array.from(tree.querySelectorAll<HTMLInputElement>('input:checked')).map((i) => ({
        path: i.value,
        kind: i.dataset.kind ?? '',
      }));

    const updateCmd = (): void => {
      const files = selected();
      const all = tree.querySelectorAll('input').length;
      const args =
        files.length === 0 || files.length === all ? '.' : files.map((f) => f.path).join(' ');
      cmd.innerHTML = `<span class="prompt">$</span> lintro check ${esc(args)} <span class="flag">--output-format grid</span>`;
      for (const label of tree.querySelectorAll<HTMLLabelElement>('label')) {
        label.classList.toggle('on', label.querySelector('input')?.checked ?? false);
      }
    };

    const toolsFor = (files: { kind: string }[]): string[] => {
      const seen = new Set<string>();
      for (const f of files) for (const t of KIND_TOOLS[f.kind] ?? []) seen.add(t);
      return [...seen];
    };

    const runCheck = (animate: boolean): void => {
      const token = ++runToken;
      const files = selected();
      const paths = files.map((f) => f.path);
      const tools = toolsFor(files);
      lines.innerHTML = '';
      findings.textContent = '';
      summary.textContent = '';
      if (tools.length === 0) {
        findings.innerHTML = '<span class="dim">No files selected. Pick something in the tree.</span>';
        score.textContent = '— / 100';
        return;
      }
      const rows = tools.map((t) => {
        const row = document.createElement('div');
        row.className = 'run-line';
        row.innerHTML = `<span>${t}</span><span class="bar"><i></i></span>`;
        lines.appendChild(row);
        return row;
      });
      let total = 0;
      let maxT = 0;
      for (const t of tools) maxT = Math.max(maxT, TOOL_RESULTS[t]?.t ?? 0);

      const finish = (row: HTMLElement, t: string): void => {
        const result = TOOL_RESULTS[t];
        if (!result) return;
        const n = result.issues(paths);
        total += n;
        row.classList.add('done');
        const status = n
          ? `<span class="wr">! ${n} issue${n > 1 ? 's' : ''}</span>`
          : '<span class="ok">✓ passed</span>';
        row.innerHTML = `<span>${t}</span><span class="res">${status} <span class="dim">(${result.t.toFixed(2)}s)</span></span>`;
      };

      const done = (): void => {
        if (token !== runToken) return;
        const out: string[] = [];
        for (const p of paths) {
          for (const f of FINDINGS[p] ?? []) {
            if (!tools.includes(f[0])) continue;
            out.push(
              `<span class="dim">${f[0].padEnd(13)}</span>${esc(f[1])} <span class="key">${esc(f[2])}</span> ${esc(f[3])}${f[4] ? '  <span class="ok">fixable</span>' : ''}`
            );
          }
        }
        const plural = paths.length > 1 ? 's' : '';
        findings.innerHTML = out.length
          ? out.join('\n')
          : `<span class="ok">No issues in ${paths.length} file${plural}.</span>`;
        const value = Math.max(0, 100 - total * 3);
        summary.textContent = `${tools.length} tools · ${paths.length} file${plural} · ${total} issue${total === 1 ? '' : 's'} · ${maxT.toFixed(2)}s wall`;
        score.textContent = `${value} / 100`;
      };

      if (!animate || REDUCE) {
        rows.forEach((row, i) => finish(row, tools[i] ?? ''));
        done();
        return;
      }
      let pending = rows.length;
      rows.forEach((row, i) => {
        const t = tools[i] ?? '';
        const ms = 250 + (TOOL_RESULTS[t]?.t ?? 0) * 500;
        const bar = row.querySelector<HTMLElement>('i');
        if (bar) {
          bar.style.transitionDuration = `${ms}ms`;
          requestAnimationFrame(() => {
            bar.style.width = '100%';
          });
        }
        setTimeout(() => {
          if (token !== runToken) return;
          finish(row, t);
          if (--pending === 0) done();
        }, ms);
      });
    };

    tree.addEventListener('change', () => {
      updateCmd();
      runCheck(true);
    });
    run.addEventListener('click', () => runCheck(true));
    updateCmd();
    runCheck(false);
  }

  /* ---------- watch simulator ---------- */
  type WatchRun = [tool: string, cls: string, status: string, secs: number, detail?: string];

  const WATCH_RUNS: Record<string, WatchRun[]> = {
    'foo.py': [
      ['ruff', 'ok', '✓ passed', 0.12],
      ['mypy', 'wr', '! 1 issue', 1.34, 'foo.py:42: Missing type annotation'],
      ['bandit', 'ok', '✓ passed', 0.4],
    ],
    'app.ts': [
      ['oxlint', 'ok', '✓ passed', 0.09],
      ['tsc', 'ok', '✓ passed', 0.88],
    ],
  };

  function clock(): string {
    const d = new Date();
    const p = (n: number): string => (n < 10 ? '0' : '') + n;
    return `[${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}]`;
  }

  function initWatch(): void {
    const log = document.getElementById('watch-log');
    const bar = document.getElementById('watch-debounce-bar');
    const txt = document.getElementById('watch-debounce-txt');
    const savePy = document.getElementById('watch-save');
    const saveTs = document.getElementById('watch-save-ts');
    if (!log || !bar || !txt || !savePy || !saveTs) return;

    let timer: ReturnType<typeof setTimeout> | null = null;
    let pending: string[] = [];

    const save = (file: string): void => {
      pending.push(file);
      if (timer) clearTimeout(timer);
      txt.textContent = pending.length > 1 ? `${pending.length} saves folded` : 'waiting for quiet';
      bar.style.transition = 'none';
      bar.style.width = '0';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          bar.style.transition = REDUCE ? 'none' : 'width 0.3s linear';
          bar.style.width = '100%';
        });
      });
      timer = setTimeout(() => {
        timer = null;
        const files = [...new Set(pending)];
        pending = [];
        let body = `<span class="key">${clock()}</span> ${files.join(', ')} modified\n`;
        const runs = files.flatMap((f) => WATCH_RUNS[f] ?? []);
        runs.forEach((r, i) => {
          const last = i === runs.length - 1;
          body += `  ${last ? '└─' : '├─'} ${r[0]}: <span class="${r[1]}">${r[2]}</span> (${r[3].toFixed(2)}s)\n`;
          if (r[4]) body += `  ${last ? '  ' : '│ '} ${esc(r[4])}\n`;
        });
        const entry = document.createElement('span');
        entry.className = 'entry is-new';
        entry.innerHTML = body;
        log.appendChild(entry);
        log.scrollTop = log.scrollHeight;
        txt.textContent = 'ran once';
        bar.style.transition = 'none';
        bar.style.width = '0';
      }, 300);
    };

    savePy.addEventListener('click', () => save('foo.py'));
    saveTs.addEventListener('click', () => save('app.ts'));
  }

  /* ---------- review simulator ---------- */
  type ReviewFinding = [
    cls: string,
    sev: string,
    loc: string,
    msg: string,
    minDepth: number,
    minStrict: string,
  ];

  const REVIEW_FINDINGS: ReviewFinding[] = [
    [
      'er',
      'P1',
      'src/api/client.py:88 ',
      'mutable default argument shared\n   across calls; <span class="dim">rubric: correctness &gt; shared state</span>',
      1,
      'focused',
    ],
    [
      'wr',
      'P2',
      'src/db/orders.py:41  ',
      'raw cursor.execute outside\n   repository layer  <span class="dim">source: no-raw-sql</span>',
      1,
      'focused',
    ],
    [
      'wr',
      'P2',
      'src/api/client.py:112',
      'retry loop swallows the last exception\n   <span class="dim">rubric: error handling &gt; silent failure · generated question</span>',
      2,
      'balanced',
    ],
    ['hi', 'P3', 'docs/usage.md:12     ', 'stale flag name --format', 1, 'balanced'],
    [
      'hi',
      'P3',
      'src/db/migrations/0042.py',
      'no down() migration\n   <span class="dim">rubric: migrations &gt; reversibility</span>',
      1,
      'thorough',
    ],
    [
      'wr',
      'P2',
      'src/api/client.py:130',
      'timeout not applied to the retry path\n   <span class="dim">adversarial pass: "what if the first attempt hangs?"</span>',
      3,
      'balanced',
    ],
    ['hi', 'P3', 'src/api/client.py:9  ', 'docstring says seconds, code uses ms', 3, 'thorough'],
  ];

  const STRICT_RANK: Record<string, number> = { focused: 0, balanced: 1, thorough: 2 };

  function initReview(): void {
    const depthEl = document.getElementById('review-depth') as HTMLSelectElement | null;
    const strictEl = document.getElementById('review-strict') as HTMLSelectElement | null;
    const out = document.getElementById('review-out');
    const cmd = document.getElementById('review-cmd');
    if (!depthEl || !strictEl || !out || !cmd) return;

    const render = (): void => {
      const depth = Number.parseInt(depthEl.value, 10);
      const strict = strictEl.value;
      cmd.innerHTML = `<span class="prompt">$</span> lintro review <span class="flag">--pr 214 --depth ${depth} --strictness ${strict} --post</span>`;
      const shown = REVIEW_FINDINGS.filter(
        (f) => f[4] <= depth && (STRICT_RANK[f[5]] ?? 0) <= (STRICT_RANK[strict] ?? 0)
      );
      let p1 = 0;
      let p2 = 0;
      let p3 = 0;
      for (const f of shown) {
        if (f[1] === 'P1') p1++;
        else if (f[1] === 'P2') p2++;
        else p3++;
      }
      const verdict = p1
        ? `<span class="er">Blocked</span> <span class="dim">(${p1} open P1)</span>`
        : p2
          ? `<span class="wr">Changes requested</span> <span class="dim">(${p2} open P2)</span>`
          : p3
            ? '<span class="hi">Nits only</span>'
            : '<span class="ok">Ready</span>';
      const calls = 2 + (depth - 1) * 2 + (strict === 'thorough' ? 1 : 0);
      const cost = (0.05 * calls + shown.length * 0.012).toFixed(2);
      let body =
        `<span class="dim">Reviewing PR #214 · 7 files · depth ${depth} · ${strict}</span>\n` +
        `<span class="dim">Coverage: 5/7 files carried from round 1 · 2 new · ${calls} provider calls</span>\n\n`;
      if (shown.length === 0) {
        body += '<span class="ok">No findings at this depth and strictness.</span>\n';
      }
      for (const f of shown) {
        body += `<span class="${f[0]}">${f[1]}</span> ${esc(f[2])} ${f[3]}\n`;
      }
      body +=
        `\n<span class="dim">Verdict:</span> ${verdict}\n` +
        `<span class="dim">Posted sticky summary + ${shown.length} inline comment${shown.length === 1 ? '' : 's'}</span>\n` +
        `<span class="dim">Cost: $${cost} · exit ${p1 ? 1 : 0} · example figures</span>`;
      out.innerHTML = body;
    };

    depthEl.addEventListener('change', render);
    strictEl.addEventListener('change', render);
    render();
  }

  function initWorkbench(): void {
    const root = document.getElementById('workbench');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';
    wireTabs(root);
    initCheck();
    initWatch();
    initReview();
  }

  initWorkbench();
  document.addEventListener('astro:page-load', initWorkbench);
</script>
