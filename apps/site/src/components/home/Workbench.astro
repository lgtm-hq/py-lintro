    white-space: pre;
    color: #cfd8e6;
  }

  .bench-out :global(.ok) {
    color: #5fd39a;
  }
  .bench-out :global(.wr) {
    color: #f2b84b;
  }
  .bench-out :global(.er) {
    color: #ff7b7b;
  }
  .bench-out :global(.dim) {
    color: #7f8da6;
  }
  .bench-out :global(.hi) {
    color: #ffd46a;
  }
  .bench-out :global(.key) {
