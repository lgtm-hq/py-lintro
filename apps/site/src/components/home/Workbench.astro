    margin: 0;
    color: var(--wb-chrome-muted);
  }

  .ctl {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .ctl button {
    padding: 6px 12px;
    border: 1px solid var(--wb-chrome-hair);
    border-radius: 6px;
