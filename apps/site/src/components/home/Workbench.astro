  }

  .filetree {
    display: grid;
    gap: 4px;
    font-family: var(--wb-font-mono);
    font-size: 0.82rem;
  }

  .filetree label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3px 6px;
    border-radius: 4px;
    color: var(--wb-chrome-muted);
    cursor: pointer;
  }

  .filetree label:hover {
    background: rgba(255, 255, 255, 0.05);
    color: var(--wb-chrome-ink);
  }

  .filetree label.on {
    color: var(--wb-chrome-ink);
