    grid-template-columns: 10ch 1fr;
    gap: 12px;
    align-items: center;
    min-height: 22px;
    font-family: var(--wb-font-mono);
    font-size: 0.82rem;
    color: #cfd8e6;
  }

  .run-lines :global(.bar) {
    position: relative;
    height: 6px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
  }

  .run-lines :global(.bar i) {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    border-radius: 3px;
    background: var(--wb-accent);
