---
import snapshot from '../generated/product-snapshot.json';
import { sourceForDocId } from '../lib/doc-route-map';
import BaseLayout from './BaseLayout.astro';
import ArticleSections from '../components/docs/ArticleSections.astro';
import DocsSectionTabs from '../components/docs/DocsSectionTabs.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsBreadcrumbs from '../components/docs/DocsBreadcrumbs.astro';
import DocsOnThisPage from '../components/docs/DocsOnThisPage.astro';
import DocsResources from '../components/docs/DocsResources.astro';
import DocsPrevNext from '../components/docs/DocsPrevNext.astro';
import DocsSectionPages from '../components/docs/DocsSectionPages.astro';
import { stripHtml } from '../data/landing';
import { documentTitle, isSectionOverview, type DocCategory } from '../data/docs-nav';
import type { DocResource } from '../lib/doc-resources';
import '../styles/docs.css';

interface Props {
  title: string;
  titleAnchor?: string;
  sourceAnchor?: string;
  description: string;
  slug: string;
  category: DocCategory;
  toc?: boolean;
  resources?: DocResource[];
  headings?: { depth: number; slug: string; text: string }[];
}

const {
  title,
  titleAnchor,
  sourceAnchor,
  description,
  slug,
  category,
  toc = true,
  resources,
  headings = [],
} = Astro.props;
const metaDescription = stripHtml(description);
const sourcePath = sourceForDocId(slug);
const sourceHref = sourcePath
  ? `https://github.com/lgtm-hq/py-lintro/blob/${snapshot.ref}/docs/${sourcePath}${sourceAnchor ? `#${sourceAnchor}` : ''}`
  : undefined;
// Planning records and dated architecture audits have distinct provenance.
const isPlanning =
  slug.startsWith('project/design') || slug.includes('/adr/') || slug === 'ai/review-execution';
const onOverview = isSectionOverview(slug, category);
---

<BaseLayout title={title} headTitle={documentTitle(slug, title)} description={metaDescription}>
  <div class="docs-shell">
    <DocsSectionTabs currentCategory={category} />
    <div class="docs-layout">
      <DocsSidebar currentSlug={slug} currentCategory={category} />
      <div class="docs-main">
        <article class="docs-content" data-pagefind-body>
          <DocsBreadcrumbs category={category} slug={slug} title={title} />
          <header class="docs-header">
            <h1 class="docs-title" id={titleAnchor || undefined} data-pagefind-weight="10">
              {title}
            </h1>
            <div class="doc-provenance" data-pagefind-ignore>
              <span>Lintro v{snapshot.version}</span>
              {sourceHref && (
                <a href={sourceHref}>
                  {slug === 'project/roadmap'
                    ? 'Historical roadmap source ↗'
                    : 'Product baseline source ↗'}
                </a>
              )}
              {slug === 'project/roadmap' && (
                <a href="https://github.com/lgtm-hq/py-lintro/issues/2288">Roadmap priorities ↗</a>
              )}
              <a href={`${import.meta.env.BASE_URL}docs/reference/cli/`}>CLI reference</a>
            </div>
          </header>
          {['project', 'project/vision', 'project/architecture'].includes(slug) && (
            <aside class="doc-notice">
              This document records the release named in its text. The CLI and tool references
              are generated from the current repository; historical audit statements below retain
              their original version.
            </aside>
          )}
          {isPlanning && (
            <aside class="doc-notice">
              Architecture and planning record. This document may describe intended behavior. Use
              the getting started, configuration and tool guides for available functionality.
            </aside>
          )}
          <ArticleSections headings={headings} />
          <div class="prose">
            <slot />
          </div>
          {onOverview && <DocsSectionPages category={category} />}
        </article>
        <DocsResources resources={resources ?? []} />
        <DocsPrevNext category={category} slug={slug} />
      </div>
      <DocsOnThisPage enabled={toc && headings.some((heading) => heading.depth >= 2 && heading.depth <= 4)} />
    </div>
  </div>
</BaseLayout>
