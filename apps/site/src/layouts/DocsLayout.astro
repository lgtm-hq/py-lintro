---
import BaseLayout from './BaseLayout.astro';
import DocsSectionTabs from '../components/docs/DocsSectionTabs.astro';
import DocsSidebar from '../components/docs/DocsSidebar.astro';
import DocsBreadcrumbs from '../components/docs/DocsBreadcrumbs.astro';
import DocsOnThisPage from '../components/docs/DocsOnThisPage.astro';
import DocsResources from '../components/docs/DocsResources.astro';
import DocsPrevNext from '../components/docs/DocsPrevNext.astro';
import DocsSectionPages from '../components/docs/DocsSectionPages.astro';
import { stripHtml } from '../data/landing';
import { isSectionOverview, type DocCategory } from '../data/docs-nav';
import type { DocResource } from '../lib/doc-resources';
import '../styles/docs.css';

interface Props {
  title: string;
  description: string;
  slug: string;
  category: DocCategory;
  toc?: boolean;
  resources?: DocResource[];
}

const { title, description, slug, category, toc = true, resources } = Astro.props;
const metaDescription = stripHtml(description);
const onOverview = isSectionOverview(slug, category);
---

<BaseLayout title={title} description={metaDescription}>
  <div class="docs-shell">
    <DocsSectionTabs currentCategory={category} />
    <div class="docs-layout">
      <DocsSidebar currentSlug={slug} currentCategory={category} />
      <main class="docs-main">
        <article class="docs-content" data-pagefind-body>
          <DocsBreadcrumbs category={category} slug={slug} title={title} />
          <header class="docs-header">
            <h1 class="docs-title">{title}</h1>
          </header>
          <div class="prose">
            <slot />
          </div>
          {onOverview && <DocsSectionPages category={category} />}
        </article>
        <DocsResources resources={resources ?? []} />
        <DocsPrevNext category={category} slug={slug} />
      </main>
      <DocsOnThisPage enabled={toc} />
    </div>
  </div>
</BaseLayout>
