include LICENSE
include README.md
include pyproject.toml
# The in-tree PEP 517 backend (#2180); the sdist must carry it.
recursive-include lintro_build *.py

# Include assets directory and its contents
recursive-include assets *
recursive-include lintro/ascii-art *
recursive-include lintro/tools *.json
# Generator input, not a distributable artifact (#2178); the rendered
# manifest.json is what ships. Mirrors [tool.setuptools.exclude-package-data].
exclude lintro/tools/manifest.src.json
recursive-include lintro/ai/prompts/templates *.md *.json

# Include any additional documentation
recursive-include docs *.md

# Repo-only trees are pruned from the sdist (#1225): the test suite and its
# sample fixtures are development-only and are not needed to build or install
# lintro from source.
prune tests
prune test_samples

# The offline eval harness (#2147) is repo-only tooling: it drives the
# installed CLI as a subprocess and must never ship in the wheel or sdist.
# The wheel already excludes it because [tool.setuptools.packages.find]
# only includes ``lintro*``; this prunes it from the sdist too.
prune evals
